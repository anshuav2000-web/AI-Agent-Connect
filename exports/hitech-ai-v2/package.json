{
  "name": "hitech-ai",
  "version": "1.0.0",
  "description": "HiTech AI — DiGiCo WhatsApp Support Platform",
  "private": true,
  "main": "dist/src/index.js",
  "scripts": {
    "postinstall": "cd client && npm install && npm run build && cd ..",
    "build": "node -e \"require('esbuild').build({entryPoints:['src/index.ts'],bundle:true,platform:'node',target:'node20',outfile:'dist/src/index.js',external:['pg','pg-native'],packages:'external'}).then(()=>console.log('Server built')).catch(e=>{console.error(e);process.exit(1)})\"",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.39.0",
    "drizzle-zod": "^0.7.0",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
