# ─────────────────────────────────────────────
# HiTech AI — Environment Variables
# Set these in Hostinger hPanel → Node.js → Environment Variables
# Do NOT rename this file to .env on Hostinger — use hPanel instead
# ─────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# PostgreSQL connection string from Hostinger Databases panel
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME

# Admin dashboard password
ADMIN_PASSWORD=YourSecurePasswordHere

# Random 40+ character string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-40-chars

# n8n Webhook URL (can also be set from Admin Dashboard later)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/xxxx

# Your live domain (for CORS in production)
CLIENT_URL=https://yourdomain.com
