# ─────────────────────────────────────────────
# HiTech AI — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Server
NODE_ENV=production
PORT=3000

# Database (PostgreSQL on Hostinger)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Admin
ADMIN_PASSWORD=YourSecurePasswordHere

# Session
SESSION_SECRET=replace-with-a-long-random-string-min-32-chars

# n8n Webhook (optional — can also be set from Admin Dashboard)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/xxxx

# Client URL (used for CORS in production)
CLIENT_URL=https://yourdomain.com
